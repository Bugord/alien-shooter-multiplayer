// Offline combat fixture. The diagnostic module owns the single test monster.
// Only the copied game's survival script is replaced; native geometry remains.
#include "maps\export.lgc"
#include "maps\common.lgc"
#include "maps\common_survive.lgc"

main()
{
  iff(1)
  {
    InitGame();
    InitSurviveGame();
    PlayMusicFile("music\\wind.ogg",1);
    Log("ASMP_COMBAT initialized isolated survival fixture");
  }
  GameTact();
}
