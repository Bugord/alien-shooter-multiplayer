// Authoritative host fixture: one ordinary native UNIT, no survival waves.
#include "maps\export.lgc"
#include "maps\common.lgc"
#include "maps\common_survive.lgc"

main()
{
  int unit;
  iff(1)
  {
    InitGame();
    InitSurviveGame();
    PlayMusicFile("music\\wind.ogg",1);
    if( Flagman(0) && GetVidData(50,VID_CLASS)==B_UNIT )
    {
      unit=CreateSprite(50,GetX(Flagman(0))+180,GetY(Flagman(0)),GetZ(Flagman(0)));
      Log("ASMP_MONSTER_HOST created vid=50 class="+itoa(GetVidData(50,VID_CLASS)));
    }
    else Log("ASMP_MONSTER_HOST no player or unexpected VID50 class");
  }
  GameTact();
}
