// Offline flying UNIT experiment. Only the copied game's script is replaced.
// No survival wave tick is called. VID290 is live-verified as class 2 + class9.
#include "maps\export.lgc"
#include "maps\common.lgc"
#include "maps\common_survive.lgc"

main()
{
  int unit;
  iff(1)
  {
    InitGame();
    InitSurviveGame();
    PlayMusicFile("music\\wind.ogg",1);
    if( Flagman(0) && GetVidData(290,VID_CLASS)==B_UNIT )
    {
      unit=CreateSprite(290,GetX(Flagman(0))+80,GetY(Flagman(0)),GetZ(Flagman(0))+DRON_FLY_HEIGHT);
      Action(unit,ACT_CHANGE_ANIMATION,ANI_STAND);
      Log("ASMP_FLYING created vid=290 class="+itoa(GetVidData(290,VID_CLASS)));
    }
    else Log("ASMP_FLYING no player or unexpected VID290 class");
  }
  GameTact();
}
